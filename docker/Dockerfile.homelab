# Custom build: upstream v0.15.0 + homelab patches. Reuses the upstream
# jellyfin-web assets unmodified (pure JS/HTML, unaffected by our Rust
# changes), but rebuilds the Dioxus dashboard and remux-server from our
# patched source - the dashboard specifically CANNOT be copied from
# upstream once its source has been edited, since upstream's compiled
# WASM bundle wouldn't contain our changes.
#
# Rust build caching is done via a persistent PVC mounted at /build-cache
# in the Kaniko pod (excluded from image snapshots with Kaniko's
# --ignore-path=/build-cache). CARGO_HOME (downloaded crates, shared) and
# CARGO_TARGET_DIR (compiled artifacts) point into it, so cargo's own
# incremental compilation reuses unchanged dependency artifacts across
# builds — source-only commits recompile only remux's own crates. This
# replaces the cargo-chef layer approach, which Kaniko's layer cache
# never reliably hit.

FROM ghcr.io/lostb1t/remux:0.15.0 AS upstream

# --- Server binary -----------------------------------------------------------
FROM --platform=linux/amd64 rust:slim-trixie AS builder
ENV CARGO_HOME=/build-cache/cargo
ENV CARGO_TARGET_DIR=/build-cache/target-server
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
# Copy the binary out of the (snapshot-ignored) cache to a tracked path so the
# final stage's COPY --from=builder works regardless of --ignore-path.
RUN cargo build --release -p remux-server \
    && cp "$CARGO_TARGET_DIR/release/remux-server" /remux-server

# --- Dashboard (WASM) --------------------------------------------------------
# Shares CARGO_HOME (crate downloads) with the server build via the PVC, but
# keeps CARGO_TARGET_DIR at the default /src/target so dx's bundled output path
# (target/dx/.../web/public) stays stable and the COPY below is unambiguous.
FROM --platform=linux/amd64 rust:slim-trixie AS dashboard-builder
ENV CARGO_HOME=/build-cache/cargo
# cargo-installed binaries (dx) land in $CARGO_HOME/bin; put it on PATH since
# CARGO_HOME is no longer the image default (/usr/local/cargo/bin).
ENV PATH="/build-cache/cargo/bin:${PATH}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config libssl-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
        | bash
RUN cargo binstall dioxus-cli@0.7.3 --no-confirm --force
WORKDIR /src
COPY . .
WORKDIR /src/crates/remux-dashboard
RUN dx build --release

FROM debian:trixie-slim

ARG GMMLIB_VER=22.8.1
ARG IGC2_VER=2.18.5
ARG IGC2_BUILD=19820
ARG NEO_VER=25.35.35096.9
ARG IGC1_LEGACY_VER=1.0.17537.24
ARG NEO_LEGACY_VER=24.35.30872.36
ARG TARGETARCH
ARG BGUTIL_POT_VER=0.8.1

ENV DEBIAN_FRONTEND=noninteractive
ENV WEB_PATH=/app/jellyfin-web
ENV DASHBOARD_PATH=/app/dashboard
ENV DATABASE_URL=sqlite:///data/db.sqlite?mode=rwc
ENV LOG_FILE=/data/logs/remux.jsonl
ENV TORRENT_DATA_DIR=/data/torrents
ENV DATA_DIR=/data
ENV FFMPEG_PATH=/usr/lib/jellyfin-ffmpeg/ffmpeg
ENV FFPROBE_PATH=/usr/lib/jellyfin-ffmpeg/ffprobe
ENV PATH="/usr/lib/jellyfin-ffmpeg:${PATH}"
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg \
    && printf "Types: deb\nURIs: https://repo.jellyfin.org/debian\nSuites: trixie\nComponents: main\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/jellyfin.gpg\n" "${TARGETARCH}" \
        > /etc/apt/sources.list.d/jellyfin.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        jellyfin-ffmpeg7 \
        python3 \
        python3-pip \
        libdrm2 \
        mesa-va-drivers \
        vainfo \
        libfontconfig1 \
        libfreetype6 \
        libssl3 \
    && pip3 install --break-system-packages yt-dlp "curl-cffi>=0.10,<0.15" \
    && if [ "${TARGETARCH}" = "amd64" ]; then BGUTIL_ARCH="x86_64"; else BGUTIL_ARCH="aarch64"; fi \
    && curl -fsSL "https://github.com/jim60105/bgutil-ytdlp-pot-provider-rs/releases/download/v${BGUTIL_POT_VER}/bgutil-pot-linux-${BGUTIL_ARCH}" \
        -o /usr/local/bin/bgutil-pot \
    && chmod +x /usr/local/bin/bgutil-pot \
    && curl -fsSL "https://github.com/jim60105/bgutil-ytdlp-pot-provider-rs/releases/download/v${BGUTIL_POT_VER}/bgutil-ytdlp-pot-provider-rs.zip" \
        -o /tmp/bgutil-plugin.zip \
    && python3 -c "import zipfile, sysconfig; zipfile.ZipFile('/tmp/bgutil-plugin.zip').extractall(sysconfig.get_path('purelib'))" \
    && rm /tmp/bgutil-plugin.zip \
    && apt-get remove -y --autoremove gnupg \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "${TARGETARCH}" = "amd64" ]; then \
        mkdir intel-compute-runtime \
        && cd intel-compute-runtime \
        && apt-get update \
        && apt-get install --no-install-recommends --no-install-suggests -y ocl-icd-libopencl1 \
        && curl -LO https://github.com/intel/compute-runtime/releases/download/${NEO_VER}/libigdgmm12_${GMMLIB_VER}_amd64.deb \
                -LO https://github.com/intel/intel-graphics-compiler/releases/download/v${IGC2_VER}/intel-igc-core-2_${IGC2_VER}+${IGC2_BUILD}_amd64.deb \
                -LO https://github.com/intel/intel-graphics-compiler/releases/download/v${IGC2_VER}/intel-igc-opencl-2_${IGC2_VER}+${IGC2_BUILD}_amd64.deb \
                -LO https://github.com/intel/compute-runtime/releases/download/${NEO_VER}/intel-opencl-icd_${NEO_VER}-0_amd64.deb \
                -LO https://github.com/intel/intel-graphics-compiler/releases/download/igc-${IGC1_LEGACY_VER}/intel-igc-core_${IGC1_LEGACY_VER}_amd64.deb \
                -LO https://github.com/intel/intel-graphics-compiler/releases/download/igc-${IGC1_LEGACY_VER}/intel-igc-opencl_${IGC1_LEGACY_VER}_amd64.deb \
                -LO https://github.com/intel/compute-runtime/releases/download/${NEO_LEGACY_VER}/intel-opencl-icd-legacy1_${NEO_LEGACY_VER}_amd64.deb \
        && apt-get install --no-install-recommends --no-install-suggests -f -y ./*.deb \
        && cd .. \
        && rm -rf intel-compute-runtime \
    ; fi \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /remux-server .
COPY --from=dashboard-builder /src/target/dx/remux-dashboard/release/web/public ./dashboard
COPY --from=upstream /app/jellyfin-web ./jellyfin-web

EXPOSE 3000

CMD ["./remux-server"]
